.ui5-input-root {
  display: inline-flex;
  flex-direction: column;
  width: 100%;
  position: relative;
  box-sizing: border-box;
  vertical-align: middle;
  outline: none;
}

.ui5-input-content {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #89919a;
  border-radius: 0.1875rem;
  background-color: #fff;
  height: 2.25rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.ui5-input-inner {
  flex: 1;
  border: none;
  height: 100%;
  padding: 0 0.75rem;
  font-size: 0.875rem;
  background: transparent;
  box-sizing: border-box;
  color: #32363a;
}

/* Value State styles */
.ui5-input-state-Negative .ui5-input-content {
  border-color: #b00;
}

.ui5-input-state-Critical .ui5-input-content {
  border-color: #e9730c;
}

.ui5-input-state-Positive .ui5-input-content {
  border-color: #107e3e;
}

.ui5-input-state-Information .ui5-input-content {
  border-color: #0a6ed1;
}

.ui5-input-clear-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 100%;
  color: #6a6d70;
  /* sapContent_IconColor: 默认中性灰 */
  font-size: 1rem;
  flex-shrink: 0;
  transition: color 0.1s ease-in, background-color 0.1s ease-in;
  box-sizing: border-box;
}

/* 优化在不同 valueState 下的清晰度 */
/* 当输入框有状态色背景时，加深图标颜色以维持对比度 */
.ui5-input-state-Negative .ui5-input-clear-icon,
.ui5-input-state-Critical .ui5-input-clear-icon,
.ui5-input-state-Positive .ui5-input-clear-icon,
.ui5-input-state-Information .ui5-input-clear-icon {
  color: #32363a;
  /* sapContent_ContrastIconColor: 更深的颜色 */
}

/* 点击态反馈 */
.ui5-input-clear-hover {
  background-color: rgba(0, 0, 0, 0.05);
  color: #0064d1 !important;
  /* sapContent_Selected_TextColor */
}

/* 禁用状态 */
.ui5-input-disabled .ui5-input-clear-icon {
  opacity: 0.4;
  pointer-events: none;
}

/* 布局微调：确保输入框文字与图标之间有足够间距 */
.ui5-input-inner {
  padding-right: 0.25rem;
}

/* 图标插槽容器样式：确保水平和垂直居中 */
.ui5-input-icon-prefix {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  /* 与输入框高度一致，保持正方形对齐 */
  height: 100%;
  flex-shrink: 0;
}

/* 当存在图标前缀时，微调内部 input 的左边距，使整体视觉更加协调 */
.ui5-input-icon-prefix+.ui5-input-inner {
  padding-left: 0.125rem;
}

/* 建议列表样式优化 */
.ui5-input-suggestion-header {
  background-color: #f7f7f7 !important;
  font-weight: bold !important;
  font-size: 0.75rem !important;
  color: #6a6d70 !important;
  border-bottom: 1px solid #eeeeee !important;
}

/* 确保弹窗内的列表充满容器 */
#ui5-input-suggestions ui5-list {
  width: 100%;
}

.ui5-input-value-state-message-content {
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  box-sizing: border-box;
  border-bottom: 2px solid transparent;
}

.ui5-input-value-state-Negative {
  color: var(--sap-value-state-error-color);
  border-bottom-color: var(--sap-value-state-error-color);
  background: #fff2f2;
}

.ui5-input-value-state-Critical {
  color: var(--sap-value-state-warning-color);
  border-bottom-color: var(--sap-value-state-warning-color);
  background: #fff8f2;
}

.ui5-input-value-state-Positive {
  color: var(--sap-value-state-success-color);
  border-bottom-color: var(--sap-value-state-success-color);
  background: #f2fff5;
}

.ui5-input-value-state-Information {
  color: var(--sap-value-state-info-color);
  border-bottom-color: var(--sap-value-state-info-color);
  background: #f2f8ff;
}

.ui5-input-value-state-message-content ui5-icon {
  font-size: 1rem;
}
