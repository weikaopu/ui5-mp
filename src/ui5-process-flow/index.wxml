<view class="ui5-process-flow ui5Class">
  <scroll-view scroll-x scroll-y class="ui5-process-flow-scroll">
    <view class="ui5-process-flow-container" id="process-flow-container"
      style="position: relative; display: inline-block; min-width: 100%;" bindtap="_onCanvasTap">
      <!-- 连线画布 -->
      <canvas type="2d" id="connection-canvas"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none;"></canvas>

      <!-- 统一网格布局容器 -->
      <view class="ui5-process-flow-grid"
        style="grid-template-columns: repeat({{maxColumns}}, 240rpx); grid-template-rows: repeat({{maxRows}}, auto);">
        <!-- 渲染泳道标题 (固定在第一行) -->
        <ui5-process-flow-lane-header wx:for="{{processedLanes}}" wx:key="id" title="{{item.label}}"
          icon="{{item.icon}}" statistics="{{item.statistics}}" state="{{item.state || 'Neutral'}}"
          style="grid-column: {{item.gridColumnStart}} / span {{item.laneWidth}}; grid-row: 1; min-height: 120rpx;" />

        <!-- 渲染节点 (根据计算出的 gridColumn 和 gridRow 准确定位) -->
        <ui5-process-flow-node wx:for="{{processedNodes}}" wx:key="id" class="ui5-process-flow-node-item"
          data-id="{{item.id}}" node-id="{{item.id}}" title="{{item.title}}" state="{{item.state}}"
          texts="{{item.texts}}" focused="{{item.focused}}" bind:node-click="_onNodeClick"
          style="grid-column: {{item.gridColumn}}; grid-row: {{item.gridRow}}; width: 240rpx;">
          <slot name="node-{{item.id}}" />
        </ui5-process-flow-node>
      </view>

      <!-- 标签详情弹出层 -->
      <view id="popover-anchor"
        style="position: absolute; {{popoverStyle}}; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></view>
      <ui5-popover id="label-popover" opener="popover-anchor" open="{{isPopoverOpen}}" header-text="Connection Detail">
        <view class="fd-padding-sm">
          <ui5-text>{{popoverText}}</ui5-text>
        </view>
      </ui5-popover>
    </view>
  </scroll-view>
</view>
