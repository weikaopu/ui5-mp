:host {
  display: block;
  width: 100%;
  min-height: 400rpx;
  /* 确保组件本身有最小高度 */
}

.ui5-process-flow-scroll {
  width: 100%;
  min-height: 300rpx;
  /* 确保 scroll-view 有最小高度以显示内容 */
  white-space: nowrap;
  /* Ensures content stays in one line for horizontal scrolling */
}

.ui5-process-flow-container {
  position: relative;
  display: inline-block;
  /* Allows content to exceed scroll-view width */
  min-width: 100%;
  /* Ensures it takes at least 100% width, but can grow */
  /* The actual width will be determined by its flex children */
}

#connection-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  /* Canvas 应该在节点上方显示 */
  pointer-events: none;
}

.ui5-process-flow-grid {
  display: grid;
  column-gap: 160rpx;
  /* 增加垂直间距，确保双向 U 形路径有足够空间 */
  row-gap: 120rpx;
  /* 增加上下内边距，确保避让路径不被 Canvas 边界截断 */
  padding: 120rpx 40rpx;
  align-items: start;
  align-items: start;
}

.ui5-process-flow-node-item {
  position: relative;
  z-index: 10;
  pointer-events: auto;
  /* 显式开启事件响应 */
  display: block;
  /* 确保自定义组件作为块级元素以获得正确的尺寸和位置 */
}
