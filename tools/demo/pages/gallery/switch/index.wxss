/* tools/demo/pages/gallery/switch/index.wxss */
/* Minimal custom styles, leveraging Fundamental Styles for layout */
.fd-padding-md {
  padding: 1rem;
}

.fd-d-flex {
  display: flex;
}

.fd-align-items-center {
  align-items: center;
}

.fd-justify-content-between {
  justify-content: space-between;
}


.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--sap-list-border-color, #eeeeee);
}

.label-cluster {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.description {
  font-size: 24rpx;
  color: var(--sap-content-label-color, #6a6d70);
  margin-top: 4rpx;
}
